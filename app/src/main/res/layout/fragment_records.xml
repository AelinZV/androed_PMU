<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="🏆 Рекорды"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="14dp" />

    <RadioGroup
        android:id="@+id/recordModes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/modeClassic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:button="@null"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="Обычная игра"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#25374D"
            android:background="@drawable/records_mode_selector"
            android:layout_marginEnd="5dp" />

        <RadioButton
            android:id="@+id/modeLevels"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:button="@null"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="Мои уровни"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#25374D"
            android:background="@drawable/records_mode_selector"
            android:layout_marginStart="5dp" />
    </RadioGroup>

    <LinearLayout
        android:id="@+id/classicFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Фильтр по сложности"
            android:textSize="16sp"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/spinnerDifficulty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/levelFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Выберите уровень"
            android:textSize="16sp"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/spinnerLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/textRecordsHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Лучший результат каждого игрока"
        android:textSize="13sp"
        android:textColor="#657388"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/textEmptyRecords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp"
        android:text="Рекордов пока нет"
        android:textSize="17sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listRecords"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:dividerHeight="8dp" />
</LinearLayout>
